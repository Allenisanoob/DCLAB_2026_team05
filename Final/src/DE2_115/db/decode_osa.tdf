--synthesis_resources = lut 8 
SUBDESIGN decode_osa
( 
	data[2..0]	:	input;
	enable	:	input;
	eq[4..0]	:	output;
) 
VARIABLE 
	data_wire[2..0]	: WIRE;
	enable_wire	: WIRE;
	eq_node[4..0]	: WIRE;
	eq_wire[7..0]	: WIRE;
	w_anode677w[3..0]	: WIRE;
	w_anode694w[3..0]	: WIRE;
	w_anode704w[3..0]	: WIRE;
	w_anode714w[3..0]	: WIRE;
	w_anode724w[3..0]	: WIRE;
	w_anode734w[3..0]	: WIRE;
	w_anode744w[3..0]	: WIRE;
	w_anode754w[3..0]	: WIRE;

BEGIN 
	data_wire[] = data[];
	enable_wire = enable;
	eq[] = eq_node[];
	eq_node[4..0] = eq_wire[4..0];
	eq_wire[] = ( w_anode754w[3..3], w_anode744w[3..3], w_anode734w[3..3], w_anode724w[3..3], w_anode714w[3..3], w_anode704w[3..3], w_anode694w[3..3], w_anode677w[3..3]);
	w_anode677w[] = ( (w_anode677w[2..2] & (! data_wire[2..2])), (w_anode677w[1..1] & (! data_wire[1..1])), (w_anode677w[0..0] & (! data_wire[0..0])), enable_wire);
	w_anode694w[] = ( (w_anode694w[2..2] & (! data_wire[2..2])), (w_anode694w[1..1] & (! data_wire[1..1])), (w_anode694w[0..0] & data_wire[0..0]), enable_wire);
	w_anode704w[] = ( (w_anode704w[2..2] & (! data_wire[2..2])), (w_anode704w[1..1] & data_wire[1..1]), (w_anode704w[0..0] & (! data_wire[0..0])), enable_wire);
	w_anode714w[] = ( (w_anode714w[2..2] & (! data_wire[2..2])), (w_anode714w[1..1] & data_wire[1..1]), (w_anode714w[0..0] & data_wire[0..0]), enable_wire);
	w_anode724w[] = ( (w_anode724w[2..2] & data_wire[2..2]), (w_anode724w[1..1] & (! data_wire[1..1])), (w_anode724w[0..0] & (! data_wire[0..0])), enable_wire);
	w_anode734w[] = ( (w_anode734w[2..2] & data_wire[2..2]), (w_anode734w[1..1] & (! data_wire[1..1])), (w_anode734w[0..0] & data_wire[0..0]), enable_wire);
	w_anode744w[] = ( (w_anode744w[2..2] & data_wire[2..2]), (w_anode744w[1..1] & data_wire[1..1]), (w_anode744w[0..0] & (! data_wire[0..0])), enable_wire);
	w_anode754w[] = ( (w_anode754w[2..2] & data_wire[2..2]), (w_anode754w[1..1] & data_wire[1..1]), (w_anode754w[0..0] & data_wire[0..0]), enable_wire);
END;
